{
  "title": "mdview",
  "nodeModulesDir": "auto",
  "unstable": [
    "kv"
  ],
  "ui": { "renderer": "aio" },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "aio",
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable"],
    "strict": true
  },
  "imports": {
    "electron": "npm:electron@^41.1.0",
    "aio": "./dep/aio/mod.ts",
    "aio/air": "./dep/aio/src/air.ts",
    "aio/jsx-runtime": "./dep/aio/src/jsx-runtime.ts",
    "immer": "npm:immer@^10",
    "@std/path": "jsr:@std/path@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@^0.1",
    "esbuild": "npm:esbuild@^0.27.3",
    "marked": "npm:marked@^14",
    "highlight.js": "npm:highlight.js@^11",
    "isomorphic-dompurify": "npm:isomorphic-dompurify@^2"
  },
  "tasks": {
    "dev": "deno run -A src/app.ts",
    "am": "deno run -A dep/aio/src/am.ts",
    "test": "deno test -A --unstable-kv src/test/",
    "test:aio": "deno test -A --unstable-kv dep/aio/tests/",
    "compile": "deno run -A dep/aio/src/build.ts --compile",
    "compile:electron": "deno run -A dep/aio/src/build.ts --compile --electron",
    "compile:electron:remote": "deno run -A dep/aio/src/build.ts --compile --electron --remote",
    "compile:android": "deno run -A dep/aio/src/build.ts --android",
    "install:electron": "deno add npm:electron && deno install --allow-scripts=npm:electron"
  },
  "allowScripts": []
}
